/* ------------------------------------------------------------------
 * 喵管家 · 设计 token
 *
 * 语言：纸 · 墨 · 朱
 *   —— 底色取宣纸，文字走墨阶，全站只留一个朱砂点睛色。
 * 字体：全宋体（Songti SC / STSong / 思源宋体）。
 *   —— 宋体字面小、重心偏上，故最小字号不得低于 20rpx(10px)，
 *      正文层用 24rpx(12px)，且行高放到 1.62。
 *
 * 命名分两段：
 *   1. 语义名（--c-ink / --c-vermilion / --c-rule）：新页面用这一套。
 *   2. 兼容名（--c-brand / --c-text / --c-line）：历史页面还在引用，
 *      在这里做同值映射，避免逐文件改一遍。
 * ------------------------------------------------------------------ */
page {
  /* 纸 */
  --c-bg: #FAF8F4;          /* 宣纸底 */
  --c-paper: #FFFFFF;       /* 更亮一层的纸，用于需要浮起的块 */

  /* 墨阶：由深到浅，共六级 */
  --c-ink: #1E1B19;         /* 主文字、当前值 */
  --c-ink-2: #4A443F;       /* 次文字、标签 */
  --c-ink-3: #7A7168;       /* 辅助 */
  --c-ink-4: #8C8178;       /* 弱化、单位 */
  --c-ink-5: #B8B0A6;       /* 最弱、占位 */
  --c-ink-6: #C9C2B8;       /* 近乎消失的注脚 */

  /* 朱：全站唯一的强调色，只用于「现在要看的那个数」与「提醒」 */
  --c-vermilion: #B5442F;
  --c-vermilion-deep: #9C3927;
  --c-vermilion-tint: #F3E7E2;

  /* 线：只做分隔，不做装饰 */
  --c-rule: #E6E0D6;
  --c-rule-soft: #F0EBE2;
  --c-rule-strong: #DED8CC;

  /* ---- 兼容映射（历史页面在用）---- */
  --c-brand: #B5442F;
  --c-brand-deep: #9C3927;
  --c-brand-tint: #F3E7E2;
  --c-text: #1E1B19;
  --c-text-2: #4A443F;
  --c-text-3: #7A7168;
  --c-text-4: #8C8178;
  --c-text-5: #B8B0A6;
  --c-line: #E6E0D6;
  --c-line-soft: #F0EBE2;
  --c-line-2: #DED8CC;
}

page {
  background: var(--c-bg);
  color: var(--c-ink);
  font-size: 28rpx;
  line-height: 1.62;
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "SimSun", serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
image,
scroll-view,
button,
input,
textarea {
  box-sizing: border-box;
}

.page {
  padding: 60rpx 48rpx 96rpx;
}

/* 卡片：去阴影，改用发丝线。留白承担分隔，框不再重复一遍。 */
.card {
  background: var(--c-paper);
  border-radius: 8rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid var(--c-rule-soft);
  box-shadow: none;
}

.card + .card {
  margin-top: 24rpx;
}

.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 44rpx 0 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--c-rule);
}

.section-title .t {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--c-ink-2);
  letter-spacing: 0.12em;
}

.section-title .more {
  font-size: 22rpx;
  color: var(--c-ink-5);
  letter-spacing: 0.06em;
  /* 热区扩展：文字只有约 36rpx 高，用伪元素撑到 88rpx，不占布局 */
  position: relative;
  display: inline-block;
}

.section-title .more::after {
  content: "";
  position: absolute;
  left: -16rpx;
  right: -16rpx;
  top: 50%;
  height: 88rpx;
  transform: translateY(-50%);
}

.muted {
  color: var(--c-ink-4);
}

.pill {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  background: var(--c-vermilion-tint);
  color: var(--c-vermilion-deep);
  letter-spacing: 0.06em;
}

/* 全站统一的按压反馈：下陷 + 墨色微退，替代原来的 opacity */
.tap {
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.tap-active {
  transform: scale(0.97);
  opacity: 0.72;
}

/* 发丝分隔线，宋体页面里比 border 更轻 */
.hairline {
  height: 1px;
  background: var(--c-rule);
}
