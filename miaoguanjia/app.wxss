/* ------------------------------------------------------------------
 * 喵管家 · 设计 token
 *
 * 语言：纸 · 墨 · 朱
 *   —— 底色取宣纸，文字走墨阶，全站只留一个朱砂点睛色。
 * 字体：全宋体（Songti SC / STSong / 思源宋体）。
 *   —— 宋体字面小、重心偏上，故最小字号不得低于 20rpx(10px)，
 *      正文层用 24rpx(12px)，且行高放到 1.62。
 *
 * 命名只有一套语义名：--c-ink（墨阶）/ --c-vermilion（朱）/ --c-rule（线）。
 * 2026-10-21 已移除 --c-text-* / --c-line-* / --c-brand-* 这组兼容别名，
 * 全站统一引用语义名，改配色只需改这一处。
 * ------------------------------------------------------------------ */
page {
  /* 纸 */
  --c-bg: #FAF8F4;          /* 宣纸底 */
  --c-paper: #FFFFFF;       /* 更亮一层的纸，用于需要浮起的块 */

  /* 墨阶：由深到浅，共六级 */
  --c-ink: #1E1B19;         /* 主文字、当前值 */
  --c-ink-2: #4A443F;       /* 次文字、标签 */
  --c-ink-3: #7A7168;       /* 辅助 */
  --c-ink-4: #8C8178;       /* 弱化、单位 */
  --c-ink-5: #B8B0A6;       /* 最弱、占位 */
  --c-ink-6: #C9C2B8;       /* 近乎消失的注脚 */

  /* 朱 = 紧急 / 就医。
     语义收窄（2026-10-21）：朱只留给「需要立刻处理」的事；
     「焦点 / 展示」交给墨阶，不再靠朱来强调。新功能的三态提示统一用下面这组，
     不要另造颜色。 */
  --c-vermilion: #AE412D;
  --c-vermilion-deep: #9C3927;
  --c-vermilion-tint: #F3E7E2;

  /* 三态语义：底色 + 前景成对使用。
     对比度已核（前景在各自底色上均 >4.5:1），不要单用某一个。 */
  /* 下面的比值为 WCAG 2.1 实测（前景 on 各自浅底），由
     `tools/assets/check_contrast.py` 复算。此前这三个数字是错的：
     写的是「朱色 / 次文 on 纸底」的值，与前景实际的底色对不上。 */
  --c-alert-fg: #AE412D;   /* 对紧急底 4.82:1 / 对纸底 5.51:1 */
  --c-alert-bg: #F3E7E2;
  --c-caution-fg: #8F5418; /* 5.15:1 */
  --c-caution-bg: #F7EADB;
  --c-safe-fg: #4A443F;    /* 8.08:1 */
  --c-safe-bg: #F0EBE2;

  /* 线：只做分隔，不做装饰 */
  --c-rule: #E6E0D6;
  --c-rule-soft: #F0EBE2;
  --c-rule-strong: #DED8CC;
}

page {
  background: var(--c-bg);
  color: var(--c-ink);
  font-size: 28rpx;
  line-height: 1.62;
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "SimSun", serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
image,
scroll-view,
button,
input,
textarea {
  box-sizing: border-box;
}

.page {
  padding: 60rpx 48rpx 96rpx;
}

/* 卡片：去阴影，改用发丝线。留白承担分隔，框不再重复一遍。 */
.card {
  background: var(--c-paper);
  border-radius: 8rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid var(--c-rule-soft);
  box-shadow: none;
}

.card + .card {
  margin-top: 24rpx;
}

.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 44rpx 0 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--c-rule);
}

.section-title .t {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--c-ink-2);
  letter-spacing: 0.12em;
}

.section-title .more {
  font-size: 24rpx;
  color: var(--c-ink-3);
  letter-spacing: 0.06em;
  /* 热区扩展：文字只有约 36rpx 高，用伪元素撑到 88rpx，不占布局 */
  position: relative;
  display: inline-block;
}

.section-title .more::after {
  content: "";
  position: absolute;
  left: -16rpx;
  right: -16rpx;
  top: 50%;
  height: 88rpx;
  transform: translateY(-50%);
}

.muted {
  color: var(--c-ink-3);
}

.pill {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
  background: var(--c-vermilion-tint);
  color: var(--c-vermilion-deep);
  letter-spacing: 0.06em;
}

/* 全站统一的按压反馈：下陷 + 墨色微退，替代原来的 opacity */
.tap {
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.tap-active {
  transform: scale(0.97);
  opacity: 0.72;
}

/* 发丝分隔线，宋体页面里比 border 更轻。
   用 1rpx 而不是 1px：1px 在 3x 屏上会渲染成 3 物理像素，且不随屏宽缩放。 */
.hairline {
  height: 1rpx;
  background: var(--c-rule);
}
