/* 几何猫形象：全部用 em，调用方只改 font-size 一个值就能整体缩放。
   配色走 CSS 变量，与纸墨朱体系一致；不引入图片资源，体积零增长。 */

.fig {
  position: relative;
  width: 1em;
  height: 1.06em;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* ---- 头 ---- */
.fig-body {
  position: relative;
  width: 0.92em;
  height: 0.80em;
  background: var(--fig);
  /* 上下略扁、下颌收一点，比正圆更像猫头 */
  border-radius: 0.44em 0.44em 0.36em 0.36em;
}

/* 耳朵：45° 旋转的方块，下半截被同色的头盖住，只露一个尖 */
/* 耳朵用 border 画宽底三角：旋转方块露出来的是窄三角，看着像兔耳 */
.fig-ear {
  position: absolute;
  top: -0.17em;
  width: 0;
  height: 0;
  border-left: 0.14em solid transparent;
  border-right: 0.14em solid transparent;
  border-bottom: 0.25em solid var(--fig);
}

.fig-ear--l { left: 0.015em; }
.fig-ear--r { right: 0.015em; }

/* ---- 眼睛 ---- */
.fig-eye {
  position: absolute;
  top: 0.35em;
  width: 0.09em;
  height: 0.145em;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
}

.fig-eye--l { left: 0.23em; }
.fig-eye--r { right: 0.23em; }

/* 鼻头：一个小圆点，眼睛下方居中 */
.fig-nose {
  position: absolute;
  top: 0.55em;
  left: 50%;
  transform: translateX(-50%);
  width: 0.08em;
  height: 0.06em;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
}

/* ---- 主色 ---- */
.fig--ink { --fig: var(--c-ink); }
.fig--vermilion { --fig: var(--c-vermilion); }
.fig--brown { --fig: var(--c-caution-fg); }
.fig--gray { --fig: var(--c-ink-3); }
.fig--cream { --fig: var(--c-rule-strong); }

/* 米色太浅，靠内描边立住轮廓，眼睛转深色 */
.fig--cream .fig-body {
  box-shadow: inset 0 0 0 0.014em rgba(30, 27, 25, 0.22);
}

.fig--cream .fig-ear {
  box-shadow: inset 0 0 0 0.014em rgba(30, 27, 25, 0.22);
}

.fig--cream .fig-eye,
.fig--cream .fig-nose {
  background: var(--c-ink-2);
}

/* ---- 配饰 ----
   统一用墨色块 + 纸白描边：任何底色上都能分辨出边界，也不会抢朱色的语义 */
.fig-acc {
  display: none;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  background: var(--c-ink);
  box-shadow: inset 0 0 0 0.012em rgba(250, 248, 244, 0.85);
}

.acc--scarf .fig-acc {
  display: block;
  bottom: 0.02em;
  width: 0.88em;
  height: 0.13em;
  border-radius: 0.02em 0.02em 0.04em 0.04em;
}

.acc--collar .fig-acc {
  display: block;
  bottom: 0.08em;
  width: 0.70em;
  height: 0.07em;
  border-radius: 0.03em;
}
