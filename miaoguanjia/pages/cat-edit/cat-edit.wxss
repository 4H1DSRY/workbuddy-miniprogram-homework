/* 校验失败提示：表单顶部公告 + 字段标红，两处配合定位 */
.form-error {
  font-size: 24rpx;
  color: var(--c-alert-fg);
  background: var(--c-alert-bg);
  border-radius: 4rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 8rpx;
  letter-spacing: 0.04em;
}

.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 16rpx;
  position: relative;
  align-self: center;
}

.big-avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  background: var(--c-rule);
}

.avatar-badge {
  margin-top: -28rpx;
  background: var(--c-paper);
  color: var(--c-ink-2);
  font-size: 24rpx;
  letter-spacing: 0.08em;
  padding: 8rpx 26rpx;
  border: 1rpx solid var(--c-rule-strong);
  border-radius: 4rpx;
}

.avatar-tip {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--c-ink-3);
  margin: 14rpx 0 8rpx;
}

.card {
  margin-top: 24rpx;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--c-rule-soft);
}

.field.last {
  border-bottom: none;
}

/* 出错字段：标签与输入值转朱，底边同步（必须放在 .field 之后，同权重后者生效） */
.field--error {
  border-bottom-color: var(--c-alert-fg);
}

.field--error .f-label,
.field--error .f-input,
.field--error .f-value {
  color: var(--c-alert-fg);
}

.f-label {
  font-size: 28rpx;
  color: var(--c-ink-2);
  flex-shrink: 0;
  width: 200rpx;
}

.f-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--c-ink);
  text-align: left;
}

.f-input.right {
  text-align: right;
}

.ph {
  color: var(--c-ink-4);
  font-size: 28rpx;
}

.f-value {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--c-ink);
}

.f-arrow {
  color: var(--c-ink-4);
  font-size: 30rpx;
  margin-left: 10rpx;
}

.f-unit-wrap {
  display: flex;
  align-items: baseline;
  flex: 1;
  justify-content: flex-end;
}

.f-unit {
  font-size: 24rpx;
  color: var(--c-ink-3);
  margin-left: 8rpx;
}

.seg {
  display: flex;
  background: var(--c-rule-soft);
  border-radius: 4rpx;
  padding: 4rpx;
}

.seg-item {
  font-size: 24rpx;
  color: var(--c-ink-3);
  padding: 10rpx 30rpx;
  border-radius: 4rpx;
  /* 热区：视觉保持 59rpx 的细胶囊，点击层撑到 88rpx */
  position: relative;
}

.seg-item::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 88rpx;
  transform: translateY(-50%);
}

.seg-item.on {
  background: var(--c-paper);
  color: var(--c-ink);
  font-weight: 400;
}

.save-btn {
  margin-top: 48rpx;
  background: var(--c-ink);
  color: var(--c-bg);
  font-size: 30rpx;
  font-weight: 400;
  letter-spacing: 0.14em;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 4rpx;
}

.del-btn {
  margin-top: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--c-vermilion);
  padding: 24rpx 0;
}

.save-btn.is-busy {
  opacity: .6;
}

.footer {
  text-align: center;
  font-size: 24rpx;
  color: var(--c-ink-3);
  margin-top: 30rpx;
}

/* ---- 形象 ---- */

.fig-wrap {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  height: 168rpx;
}

.sw-row {
  display: flex;
  align-items: center;
  /* 每个 88rpx 容器里只有 44rpx 的圆点，视觉间距已经够，不需要再加 gap */
  gap: 0;
  flex-shrink: 0;
}

/* 色块：88rpx 容器承担热区，44rpx 的圆点画在 ::before 里，
   这样视觉还是一个 44rpx 的点，但点击区达到 88rpx，不用伪元素 hack */
.swatch {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.swatch::before {
  content: "";
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
}

/* 选中环用外阴影叠加，不改变圆点尺寸 */
.swatch.on::before {
  box-shadow: 0 0 0 3rpx var(--c-paper), 0 0 0 5rpx var(--c-ink);
}

/* 直接给 ::before 上色，不用局部变量：check.js 要求所有 var() 都在 app.wxss 里有定义 */
.swatch--ink::before { background: var(--c-ink); }
.swatch--vermilion::before { background: var(--c-vermilion); }
.swatch--brown::before { background: var(--c-caution-fg); }
.swatch--gray::before { background: var(--c-ink-3); }
.swatch--cream::before { background: var(--c-rule-strong); }
