<view class="page">

  <!-- 校验失败时在表单顶部告知原因，并配合下方字段标红（指南 2.3） -->
  <view class="form-error" wx:if="{{errorMsg}}">{{errorMsg}}</view>

  <!-- 头像 -->
  <view class="avatar-wrap" bindtap="onPickAvatar">
    <image class="big-avatar" src="{{form.avatar}}" mode="aspectFill" />
    <view class="avatar-badge">换头像</view>
  </view>
  <text class="avatar-tip">建议用自己拍的猫咪照片替换占位图</text>

  <!-- 基本信息 -->
  <view class="card">
    <view class="field {{errorField === 'name' ? 'field--error' : ''}}" id="f-name">
      <text class="f-label">名字</text>
      <input
        class="f-input"
        value="{{form.name}}"
        placeholder="给猫咪取个名字"
        placeholder-class="ph"
        maxlength="12"
        bindinput="onName"
      />
    </view>

    <picker mode="selector" range="{{breeds}}" value="{{breedIndex}}" bindchange="onBreed">
      <view class="field">
        <text class="f-label">品种</text>
        <view class="f-value">
          <text>{{form.breed}}</text>
          <text class="f-arrow">›</text>
        </view>
      </view>
    </picker>

    <view class="field">
      <text class="f-label">性别</text>
      <view class="seg">
        <view class="seg-item {{form.gender === 'male' ? 'on' : ''}}" data-g="male" bindtap="onGender">弟弟</view>
        <view class="seg-item {{form.gender === 'female' ? 'on' : ''}}" data-g="female" bindtap="onGender">妹妹</view>
      </view>
    </view>

    <picker mode="date" value="{{form.birthday}}" start="2010-01-01" end="{{todayStr}}" bindchange="onBirthday">
      <view class="field">
        <text class="f-label">生日</text>
        <view class="f-value">
          <text>{{form.birthday}}</text>
          <text class="f-arrow">›</text>
        </view>
      </view>
    </picker>
  </view>

  <!-- 喂养参数 -->
  <view class="section-title">
    <text class="t">喂养参数</text>
  </view>

  <view class="card">
    <view class="field {{errorField === 'weight' ? 'field--error' : ''}}" id="f-weight">
      <text class="f-label">当前体重</text>
      <view class="f-unit-wrap">
        <input
          class="f-input right"
          type="digit"
          value="{{form.weight}}"
          bindinput="onWeight"
          placeholder="0.00"
          placeholder-class="ph"
        />
        <text class="f-unit">kg</text>
      </view>
    </view>

    <view class="field {{errorField === 'foodTarget' ? 'field--error' : ''}}" id="f-foodTarget">
      <text class="f-label">每日进食目标</text>
      <view class="f-unit-wrap">
        <input
          class="f-input right"
          type="number"
          value="{{form.foodTarget}}"
          bindinput="onTarget"
          placeholder="180"
          placeholder-class="ph"
        />
        <text class="f-unit">g</text>
      </view>
    </view>

    <view class="field last">
      <text class="f-label">备注</text>
      <input
        class="f-input right"
        value="{{form.note}}"
        placeholder="性格 / 忌口"
        placeholder-class="ph"
        maxlength="20"
        bindinput="onNote"
      />
    </view>
  </view>

  <!-- 形象：几何轮廓，与真猫照片二选一，默认仍用照片 -->
  <view class="section-title">
    <text class="t">形象</text>
    <text class="s">不想要照片时，用几何形象代替</text>
  </view>

  <view class="card">
    <view class="field">
      <text class="f-label">显示方式</text>
      <view class="seg">
        <view class="seg-item {{avatarType === 'photo' ? 'on' : ''}}" data-v="photo" bindtap="onAvatarType">用照片</view>
        <view class="seg-item {{avatarType === 'figure' ? 'on' : ''}}" data-v="figure" bindtap="onAvatarType">用形象</view>
      </view>
    </view>

    <view class="field">
      <text class="f-label">预览</text>
      <view class="fig-wrap">
        <cat-figure color="{{figure.color}}" accessory="{{figure.accessory}}" size="168rpx" />
      </view>
    </view>

    <view class="field">
      <text class="f-label">主色</text>
      <view class="sw-row">
        <view
          class="swatch swatch--{{item.key}} {{figure.color === item.key ? 'on' : ''}}"
          wx:for="{{figureColors}}"
          wx:key="key"
          data-k="{{item.key}}"
          bindtap="onPickColor"
        ></view>
      </view>
    </view>

    <view class="field last">
      <text class="f-label">配饰</text>
      <view class="seg">
        <view
          class="seg-item {{figure.accessory === a.key ? 'on' : ''}}"
          wx:for="{{figureAccessories}}"
          wx:for-item="a"
          wx:key="key"
          data-k="{{a.key}}"
          bindtap="onPickAcc"
        >{{a.label}}</view>
      </view>
    </view>
  </view>

  <view class="save-btn {{submitting ? 'is-busy' : ''}}" bindtap="onSave">{{submitting ? '保存中…' : '保存档案'}}</view>
  <view class="del-btn" wx:if="{{isEdit}}" bindtap="onDelete">删除这只猫</view>

  <view class="footer">资料仅保存在本机，换手机不会同步</view>

</view>
