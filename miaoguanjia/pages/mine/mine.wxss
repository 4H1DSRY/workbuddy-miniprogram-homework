.profile {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  background: linear-gradient(140deg, var(--c-paper) 0%, var(--c-paper)6EE 100%);
}

.profile-ico {
  width: 44rpx;
  height: 44rpx;
}

.row-ico-img {
  width: 38rpx;
  height: 38rpx;
}

.profile-avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 8rpx;
  background: var(--c-vermilion-tint);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex-shrink: 0;
}

.profile-meta {
  flex: 1;
  margin-left: 24rpx;
}

.profile-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
}

.profile-sub {
  display: block;
  font-size: 22rpx;
  color: var(--c-text-4);
  margin-top: 8rpx;
}

.profile-pill {
  font-size: 20rpx;
  color: var(--c-brand-deep);
  background: var(--c-vermilion-tint);
  border-radius: 4rpx;
  padding: 6rpx 18rpx;
}

/* 统计 */
.stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 30rpx 10rpx;
  margin-top: 24rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--c-text);
  line-height: 1.2;
}

.stat-label {
  font-size: 21rpx;
  color: var(--c-text-4);
  margin-top: 6rpx;
}

.stat-line {
  width: 1rpx;
  height: 48rpx;
  background: var(--c-line);
}

/* 通用列表 */
.list-card {
  padding: 4rpx 28rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--c-line-soft);
}

.row.last {
  border-bottom: none;
}

.row-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 8rpx;
  background: var(--c-line);
  flex-shrink: 0;
}

.row-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

/* 所有行统一：72rpx 空槽 + 38rpx 线条图标，不铺底色。
   底色会让「设备」和「提醒」两张卡看起来不是一套。 */

.row-body {
  flex: 1;
  margin-left: 22rpx;
  min-width: 0;
}

.row-avatar + .row-body {
  margin-left: 22rpx;
}

.row-title {
  display: block;
  font-size: 28rpx;
  color: var(--c-text);
  font-weight: 500;
}

.row-sub {
  display: block;
  font-size: 22rpx;
  color: var(--c-text-4);
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row-arrow {
  font-size: 34rpx;
  color: var(--c-ink-6);
  margin-left: 12rpx;
}

.picker-btn {
  font-size: 24rpx;
  color: var(--c-ink-2);
  background: var(--c-paper);
  border: 1rpx solid var(--c-rule-strong);
  border-radius: 4rpx;
  padding: 10rpx 26rpx;
  letter-spacing: 0.08em;
}

.empty-row {
  justify-content: space-between;
}

.footer {
  text-align: center;
  font-size: 22rpx;
  color: var(--c-ink-4);
  margin-top: 44rpx;
  letter-spacing: 0.06em;
}
