/* ------------------------------------------------------------------
 * 首页 · 纸墨朱
 * rpx 换算：1px = 2rpx（设计稿按 375 宽）
 * 字号只有四层：20(注) / 24(标签) / 68(名字) / 92(数值)，中间刻意空着。
 * ------------------------------------------------------------------ */

/* 一屏说完：按 iPhone X（812pt）排满，内容底距 tabBar 约 20pt，
   视觉上刚好落地，不出现「下面空一截」。
   间距是固定的，所以换更高的屏（14 Pro Max / 多数安卓）会重新多出空白，
   换更矮的屏则会滚动——不做 100vh + flex 分配，那会让每一段随着屏高浮起来，
   反而失去现在这种「每一段都有确定的落点」的观感。 */
.page {
  padding-top: 32rpx;
  padding-bottom: 20rpx;
}

.topline {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.date {
  font-size: 24rpx;
  color: var(--c-ink-3);
  letter-spacing: 0.18em;
}

.switcher {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

/* 热区 88rpx 由 view 撑起，再用上下各 -27rpx 的负边距把占位压回约 34rpx，
   顶栏高度不变。左右各 9rpx 内边距吃掉 18rpx 间距的一半，相邻两个刚好相接不重叠。
   为什么不给 <text> 加 padding：伪元素与盒模型在 <text> 上都不可靠（已实测）。 */
.sw-hit {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin: -27rpx 0 -27rpx 18rpx;
  padding: 0 9rpx;
  position: relative;
}

.sw-hit-hover {
  opacity: 0.6;
}

.sw {
  font-size: 24rpx;
  color: var(--c-ink-3);
  letter-spacing: 0.06em;
}

/* 当前猫只靠墨色深浅区分（ink vs ink-3），24rpx 小字下几乎看不出差别。
   补一条与名字等宽的实线：纸面上「划出来」比「压暗隔壁」更明确。 */
.sw-hit.on .sw {
  color: var(--c-ink);
}

.sw-hit.on::after {
  content: "";
  position: absolute;
  left: 9rpx;
  right: 9rpx;
  bottom: 20rpx;
  height: 1rpx;
  background: var(--c-ink);
}

.sw-add {
  font-size: 28rpx;
  color: var(--c-ink-3);
  line-height: 1;
}

.hairline {
  margin-top: 16rpx;
}

/* ---- 名字 ---- */
/* 名字与副标题一行。名字吃剩余宽度、超长省略，副标题固定不缩——
   名字可以省，副标题不能被名字顶掉（它承载品种与年龄，省了就没了）。 */
.name-row {
  display: flex;
  align-items: baseline;
  margin-top: 28rpx;
}

.name {
  font-size: 68rpx;
  line-height: 1.15;
  letter-spacing: 0.14em;
  color: var(--c-ink);
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sub {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--c-ink-3);
  letter-spacing: 0.08em;
  /* 名字末字的 letter-spacing 已经留了 9.5rpx 的空，这里只补 6rpx，
     合起来约 16rpx，比字内间距略宽，读得出是两段不同的信息 */
  margin-left: 6rpx;
}

/* ---- 照片：4rpx 极小圆角，只削掉尖角，不改性格 ---- */
/* 照片槽。比例定成 3:2 而不是原来的 2.48:1 横幅：
   横幅按宽度裁满时只剩画面中间的一条，猫的下巴和身子全被切掉。3:2 是照片
   本来的比例，配 aspectFit 就是「整张图原样放进来」，一张图都不用裁。
   用户自己换的图比例不可控，其它比例会在槽位里留边——留边比切掉半张脸好。

   圆角取 12rpx（≈6pt）：比常见的卡片圆角（16–24rpx）小一号，
   不和方形的照顾环、直角的动作带打架，但在视网膜屏上明确看得出来。
   槽位与图片都要写：槽位负责裁掉溢出的部分，图片自己也要圆，
   否则 aspectFit 留白时能看到图片的直角压在圆角槽位上。 */
.photo-slot {
  width: 100%;
  height: 436rpx;
  margin-top: 32rpx;
  background: var(--c-rule-soft);
  overflow: hidden;
  border-radius: 12rpx;
}

.photo {
  display: block;
  width: 100%;
  height: 436rpx;
  border-radius: 12rpx;
}

/* ---- 体重 + 今日照顾 ---- */
.weigh {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 30rpx;
}

.weigh-main {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.num {
  font-size: 92rpx;
  line-height: 1;
  letter-spacing: 0.01em;
  color: var(--c-ink);
}

.unit {
  font-size: 24rpx;
  color: var(--c-ink-3);
  letter-spacing: 0.06em;
  margin-left: 10rpx;
}

.delta {
  font-size: 24rpx;
  color: var(--c-vermilion);
  margin-left: 20rpx;
  letter-spacing: 0.02em;
}

.delta.down {
  color: var(--c-ink-3);
}

/* 标签在左、环在右，底边对齐：文字盒落在环的最后 34rpx 高度带里，
   此时圆弧左缘已经收到 x≈3rpx，最后一个字正好咬住圆弧——
   「左下角紧贴」是这么量出来的，不是压上去的。
   底对齐后文字盒内还有约 5rpx 的字形留白，所以字形看起来贴住环底而不压色。 */
.ring-wrap {
  display: flex;
  align-items: flex-end;
  flex-shrink: 0;
}

.ring {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-hole {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--c-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-num {
  font-size: 34rpx;
  line-height: 1;
  color: var(--c-ink);
}

.ring-cap {
  font-size: 24rpx;
  color: var(--c-ink-3);
  letter-spacing: 0.08em;
  /* 与圆弧留出约 10rpx：底对齐时弧线已经收到最近，再贴上去就挤成一团了。
     负值只是抵掉末字的 letter-spacing 尾距（1.9rpx），净距仍是 8rpx。 */
  margin-right: 8rpx;
}

/* ---- 三条刻度 ---- */
.bars {
  margin-top: 32rpx;
  border-top: 1rpx solid var(--c-rule);
}

.bar {
  display: flex;
  align-items: center;
  height: 66rpx;
  border-bottom: 1rpx solid var(--c-rule-soft);
}

.bar-label {
  width: 78rpx;
  font-size: 24rpx;
  color: var(--c-ink-2);
  letter-spacing: 0.08em;
  flex-shrink: 0;
}

.bar-track {
  flex: 1;
  height: 2rpx;
  background: var(--c-rule-strong);
  margin: 0 24rpx;
  position: relative;
}

.bar-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 2rpx;
  background: var(--c-ink);
}

/* 饮水用次级墨色：不是每一条都同等重要 */
.bar-fill.soft {
  background: var(--c-ink-3);
}

.bar-val {
  width: 170rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--c-ink-3);
  letter-spacing: 0.02em;
  flex-shrink: 0;
}

/* ---- 心情自评 ----
 * 与上面三条刻度刻意不同构：刻度是读出来的，这一行是写进去的。
 * 没有进度条、没有百分比，五个方格填墨即止，右侧只给一句主观词。
 * 格子视觉 18rpx，热区 44rpx——18rpx 在真机上点不中。 */
.mood {
  display: flex;
  align-items: center;
  height: 44rpx;
  margin-top: 22rpx;
}

/* 与 .bar-label 同宽同色，左边缘与上面三条对齐 */
.mood-label {
  width: 78rpx;
  font-size: 24rpx;
  color: var(--c-ink-2);
  letter-spacing: 0.08em;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 与 .bar-track 同一起点（左 78rpx 标签 + 24rpx 缩进）。
   右端比三条刻度长：刻度右侧要放 "160 / 200 g" 这种七个字符，这一行只放
   "未知" 两个字（或"很好"这种两字评价），让出来的宽度全给格子——每格约 92rpx，
   才够 88rpx 的热区下限。
   方格在各自格子里居中，所以首尾各内缩半格：位置大致编码分值，
   不能当成「0 分贴线首、5 分贴线尾」来读。 */
.mood-cells {
  flex: 1;
  display: flex;
  align-items: center;
  margin: 0 24rpx;
}

/* 热区 88rpx（44px / 7mm，指南 3.2 的下限）。行高仍是 44rpx，
   多出来的 44rpx 用上下各 -22rpx 的负边距挂到行外——
   向上落进三条刻度之间的空白，不压下面那条动作带。
   宽度由 flex:1 均分，约 92rpx（按右侧 84rpx 的列宽反推）。 */
.mood-cell {
  flex: 1;
  height: 88rpx;
  margin: -22rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 描边用 2rpx 而不是 1rpx。
   1rpx 在 750rpx 换算下是半个 pt，在 @3x 屏上是 1.57 个物理像素——
   方形恰好落在非整数位置上时，四条边被抗锯齿分摊的比例各不相同，
   最右那一格就出现过「左、上、下都在，右边被摊成一片浅灰」，
   看起来像没闭合。2rpx（≈1pt / 3 物理像素）四边都是整像素，不会只剩三条。
   尺寸同步 18→20rpx：边从占宽 5.5% 变成 10%，把方块放大一点抵掉这份重量。 */
.mood-cell::before {
  content: "";
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid var(--c-ink-4);
  box-sizing: border-box;
}

.mood-cell.on::before {
  background: var(--c-ink);
  border-color: var(--c-ink);
}

/* 按下未选中的格子时先给一点回声，否则点空的没反应会以为坏了 */
.mood-cell-hover::before {
  background: var(--c-rule-strong);
}

/* 与 .bar-val 同为右对齐（右边缘对齐内容区右侧）。
   宽度收到 84rpx 是为了把空间让给五个热区：每个从 71rpx 变成 92rpx。 */
.mood-word {
  width: 84rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--c-ink-3);
  flex-shrink: 0;
}

/* ---- 五个动作 ----
 * 原先这里只有图标和字，形态与底部 tabBar 完全一致（图标在上、字在下、五等分、无容器），
 * 用户会把「导航的位置形态」认成「导航」，可它是操作。补上纸格：
 * 上下各一条发丝线围成一条带，格与格之间一条竖线。
 * 表格线是纸本来就有的东西，不引入色块、不新增第二个朱色焦点。 */
.acts {
  display: flex;
  margin-top: 26rpx;
  border-top: 1rpx solid var(--c-rule);
  border-bottom: 1rpx solid var(--c-rule);
  /* 铺一层比纸深半度的底：直角浅色带与 tabBar 的纯纸底区分开，
     眼睛先认出「这一条是另一种东西」，再读上面的五个字。 */
  background: var(--c-rule-soft);
}

.act {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0 10rpx;
  position: relative;
}

/* 分格竖线画在格子左缘，第一格留空 */
.act + .act::before {
  content: "";
  position: absolute;
  left: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 1rpx;
  background: var(--c-rule-soft);
}

.act-ico {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 12rpx;
}

/* 字提到主墨色：格子里写的东西是正文，不是注脚 */
.act-txt {
  font-size: 24rpx;
  color: var(--c-ink);
  letter-spacing: 0.12em;
}

/* ---- 底部 ----
 * 上横线由 .acts 的 border-bottom 承担，这里不再画第二条，
 * 否则动作带底下会出现两条 26rpx 间距的平行线。 */
.foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 0;
  padding-top: 34rpx;
  font-size: 24rpx;
  color: var(--c-ink-3);
  letter-spacing: 0.04em;
  /* 热区扩展：整行加高到 88rpx，但用伪元素，不改变现有排布与一屏高度 */
  position: relative;
}

.foot::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 88rpx;
  transform: translateY(-50%);
}

.foot .n {
  color: var(--c-ink);
}

.foot .ar {
  color: var(--c-ink-5);
}

/* ---- 空状态 ---- */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 40rpx 0;
}

.empty-title {
  font-size: 44rpx;
  letter-spacing: 0.12em;
  color: var(--c-ink);
}

.empty-sub {
  font-size: 24rpx;
  color: var(--c-ink-3);
  margin-top: 18rpx;
  text-align: center;
  letter-spacing: 0.04em;
}

.empty-btn {
  margin-top: 56rpx;
  padding: 25rpx 52rpx;
  border: 1rpx solid var(--c-ink);
  font-size: 24rpx;
  color: var(--c-ink);
  letter-spacing: 0.14em;
  border-radius: 4rpx;
}

/* ---- 用量面板 ----
 * 形态取「从纸下抽出一张纸条」：直角、单条上发丝线、不用圆角卡片与阴影。
 * 遮罩用主墨色压到 28% 不透明度，而不是 rgba 黑——纸墨体系里没有纯黑。 */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background: var(--c-ink);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.18s ease, visibility 0.18s ease;
}

.sheet-mask.on {
  opacity: 0.28;
  visibility: visible;
}

/* 页面是 tabBar 页，webview 底边本来就在 tabBar 之上，
   所以底部只留常规内边距，不再叠 env(safe-area-inset-bottom) 造成空洞。 */
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  padding: 36rpx 48rpx 32rpx;
  background: var(--c-bg);
  border-top: 1rpx solid var(--c-rule);
  transform: translateY(104%);
  transition: transform 0.22s cubic-bezier(0.32, 0.72, 0, 1);
}

.sheet.on {
  transform: translateY(0);
}

.sheet-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.sheet-title {
  font-size: 34rpx;
  color: var(--c-ink);
  letter-spacing: 0.12em;
}

.sheet-sub {
  font-size: 24rpx;
  color: var(--c-ink-3);
  letter-spacing: 0.02em;
}

/* 五档等分：750 - 96(内边距) - 48(四处间隔) = 606，每格约 121rpx。
   高度直接给 88rpx，它就是热区，不靠伪元素撑——这一条不需要压回原行高。 */
.sheet-opts {
  display: flex;
  margin-top: 24rpx;
}

.opt {
  flex: 1;
  height: 88rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--c-rule-strong);
}

.opt:last-child {
  margin-right: 0;
}

.opt-n {
  font-size: 28rpx;
  color: var(--c-ink);
  letter-spacing: 0.02em;
}

/* 选中反白：这一格是「已填进去的当前值」，与输入框里的数字是同一个事实 */
.opt.on {
  background: var(--c-ink);
  border-color: var(--c-ink);
}

.opt.on .opt-n {
  color: var(--c-bg);
}

.opt-hover {
  background: var(--c-rule-soft);
}

.sheet-row {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin-top: 20rpx;
  border-bottom: 1rpx solid var(--c-rule);
}

.sheet-input {
  flex: 1;
  font-size: 44rpx;
  color: var(--c-ink);
  letter-spacing: 0.02em;
}

.sheet-ph {
  color: var(--c-ink-5);
}

.sheet-unit {
  font-size: 24rpx;
  color: var(--c-ink-3);
  margin-left: 8rpx;
}

/* 预告行：选择时就说清「记完是多少、超不超」。
   朱色只给喂食超量——饮水超参考量不是坏事，压成同一色会误导。 */
.sheet-tip {
  display: block;
  min-height: 34rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--c-ink-3);
  letter-spacing: 0.02em;
}

.sheet-tip.over {
  color: var(--c-vermilion);
}

.sheet-tip.note {
  color: var(--c-ink-2);
}

.sheet-btn {
  height: 88rpx;
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--c-ink);
}

.sheet-btn-hover {
  background: var(--c-ink-2);
}

.sheet-btn-txt {
  font-size: 28rpx;
  color: var(--c-bg);
  letter-spacing: 0.2em;
  /* 字距会把最后一个字往左带，补一格让光学重心回到正中 */
  margin-left: 0.2em;
}
