/* ------------------------------------------------------------------
 * 首页 · 纸墨朱
 * rpx 换算：1px = 2rpx（设计稿按 375 宽）
 * 字号只有四层：20(注) / 24(标签) / 68(名字) / 92(数值)，中间刻意空着。
 * ------------------------------------------------------------------ */

.topline {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.date {
  font-size: 20rpx;
  color: var(--c-ink-4);
  letter-spacing: 0.18em;
}

.switcher {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.sw {
  font-size: 22rpx;
  color: var(--c-ink-5);
  letter-spacing: 0.06em;
  margin-left: 18rpx;
}

.sw.on {
  color: var(--c-ink);
  font-size: 24rpx;
}

.sw-add {
  font-size: 26rpx;
  color: var(--c-ink-5);
  margin-left: 18rpx;
  line-height: 1;
}

.hairline {
  margin-top: 24rpx;
}

/* ---- 名字 ---- */
.name {
  font-size: 68rpx;
  line-height: 1.15;
  letter-spacing: 0.14em;
  margin-top: 52rpx;
  color: var(--c-ink);
}

.sub {
  font-size: 24rpx;
  color: var(--c-ink-4);
  letter-spacing: 0.08em;
  margin-top: 16rpx;
}

/* ---- 照片：直角切割，不加圆角 ---- */
.photo {
  display: block;
  width: 100%;
  height: 392rpx;
  margin-top: 44rpx;
  background: var(--c-rule-soft);
}

/* ---- 体重 + 今日照顾 ---- */
.weigh {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 40rpx;
}

.weigh-main {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.num {
  font-size: 92rpx;
  line-height: 1;
  letter-spacing: 0.01em;
  color: var(--c-ink);
}

.unit {
  font-size: 24rpx;
  color: var(--c-ink-4);
  letter-spacing: 0.06em;
  margin-left: 10rpx;
}

.delta {
  font-size: 24rpx;
  color: var(--c-vermilion);
  margin-left: 20rpx;
  letter-spacing: 0.02em;
}

.delta.down {
  color: var(--c-ink-3);
}

.ring-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.ring {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-hole {
  width: 94rpx;
  height: 94rpx;
  border-radius: 50%;
  background: var(--c-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-num {
  font-size: 34rpx;
  line-height: 1;
  color: var(--c-ink);
}

.ring-cap {
  font-size: 20rpx;
  color: var(--c-ink-5);
  letter-spacing: 0.08em;
  margin-top: 14rpx;
}

/* ---- 三条刻度 ---- */
.bars {
  margin-top: 52rpx;
  border-top: 1rpx solid var(--c-rule);
}

.bar {
  display: flex;
  align-items: center;
  height: 68rpx;
  border-bottom: 1rpx solid var(--c-rule-soft);
}

.bar-label {
  width: 78rpx;
  font-size: 24rpx;
  color: var(--c-ink-2);
  letter-spacing: 0.08em;
  flex-shrink: 0;
}

.bar-track {
  flex: 1;
  height: 1px;
  background: var(--c-rule-strong);
  margin: 0 24rpx;
  position: relative;
}

.bar-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 1px;
  background: var(--c-ink);
}

/* 饮水用次级墨色：不是每一条都同等重要 */
.bar-fill.soft {
  background: var(--c-ink-3);
}

.bar-val {
  width: 170rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--c-ink-4);
  letter-spacing: 0.02em;
  flex-shrink: 0;
}

/* ---- 四个动作 ---- */
.acts {
  display: flex;
  margin-top: 44rpx;
}

.act {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.act-ico {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 20rpx;
}

.act-txt {
  font-size: 24rpx;
  color: var(--c-ink-2);
  letter-spacing: 0.12em;
}

/* ---- 底部 ---- */
.foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 36rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--c-rule);
  font-size: 24rpx;
  color: var(--c-ink-4);
  letter-spacing: 0.04em;
}

.foot .n {
  color: var(--c-ink);
}

.foot .ar {
  color: var(--c-ink-5);
}

/* ---- 空状态 ---- */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 40rpx 0;
}

.empty-title {
  font-size: 40rpx;
  letter-spacing: 0.12em;
  color: var(--c-ink);
}

.empty-sub {
  font-size: 24rpx;
  color: var(--c-ink-4);
  margin-top: 18rpx;
  text-align: center;
  letter-spacing: 0.04em;
}

.empty-btn {
  margin-top: 56rpx;
  padding: 20rpx 52rpx;
  border: 1rpx solid var(--c-ink);
  font-size: 24rpx;
  color: var(--c-ink);
  letter-spacing: 0.14em;
  border-radius: 4rpx;
}
