/* ------------------------------------------------------------------
 * 首页 · 纸墨朱
 * rpx 换算：1px = 2rpx（设计稿按 375 宽）
 * 字号只有四层：20(注) / 24(标签) / 68(名字) / 92(数值)，中间刻意空着。
 * ------------------------------------------------------------------ */

/* 一屏说完：iPhone X 内容区 ≈ 1282rpx，本页压到 1230 左右，不留半截在折线下。 */
.page {
  padding-top: 32rpx;
  padding-bottom: 40rpx;
}

.topline {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.date {
  font-size: 24rpx;
  color: var(--c-ink-3);
  letter-spacing: 0.18em;
}

.switcher {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.sw {
  font-size: 24rpx;
  color: var(--c-ink-3);
  letter-spacing: 0.06em;
  margin-left: 18rpx;
  /* 热区扩展：左右各外扩 9rpx（吃掉 18rpx 间距的一半），相邻两个刚好相接不重叠 */
  position: relative;
}

.sw::after {
  content: "";
  position: absolute;
  left: -9rpx;
  right: -9rpx;
  top: 50%;
  height: 88rpx;
  transform: translateY(-50%);
}

/* 当前猫只靠墨色深浅区分（ink vs ink-3），24rpx 小字下几乎看不出差别。
   补一条与名字等宽的实线：纸面上「划出来」比「压暗隔壁」更明确。
   注意：伪元素画在 <text> 上微信渲染层不生效（已实测），所以用 border-bottom。 */
.sw.on {
  color: var(--c-ink);
  font-size: 24rpx;
  border-bottom: 1rpx solid var(--c-ink);
  padding-bottom: 8rpx;
}

.sw-add {
  font-size: 28rpx;
  color: var(--c-ink-3);
  margin-left: 18rpx;
  line-height: 1;
  position: relative;
}

.sw-add::after {
  content: "";
  position: absolute;
  left: -9rpx;
  right: -9rpx;
  top: 50%;
  height: 88rpx;
  transform: translateY(-50%);
}

.hairline {
  margin-top: 20rpx;
}

/* ---- 名字 ---- */
.name {
  font-size: 68rpx;
  line-height: 1.15;
  letter-spacing: 0.14em;
  margin-top: 32rpx;
  color: var(--c-ink);
}

.sub {
  font-size: 24rpx;
  color: var(--c-ink-3);
  letter-spacing: 0.08em;
  margin-top: 14rpx;
}

/* ---- 照片：直角切割，不加圆角 ---- */
/* 照片 / 形象共用一个槽位，高度 300rpx 不变（一屏预算就是按它算的） */
.photo-slot {
  width: 100%;
  height: 264rpx;
  margin-top: 40rpx;
  background: var(--c-rule-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.photo {
  display: block;
  width: 100%;
  height: 264rpx;
}

/* ---- 体重 + 今日照顾 ---- */
.weigh {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 22rpx;
}

.weigh-main {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.num {
  font-size: 92rpx;
  line-height: 1;
  letter-spacing: 0.01em;
  color: var(--c-ink);
}

.unit {
  font-size: 24rpx;
  color: var(--c-ink-3);
  letter-spacing: 0.06em;
  margin-left: 10rpx;
}

.delta {
  font-size: 24rpx;
  color: var(--c-vermilion);
  margin-left: 20rpx;
  letter-spacing: 0.02em;
}

.delta.down {
  color: var(--c-ink-3);
}

.ring-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.ring {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-hole {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--c-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-num {
  font-size: 34rpx;
  line-height: 1;
  color: var(--c-ink);
}

.ring-cap {
  font-size: 24rpx;
  color: var(--c-ink-3);
  letter-spacing: 0.08em;
  margin-top: 12rpx;
}

/* ---- 三条刻度 ---- */
.bars {
  margin-top: 28rpx;
  border-top: 1rpx solid var(--c-rule);
}

.bar {
  display: flex;
  align-items: center;
  height: 60rpx;
  border-bottom: 1rpx solid var(--c-rule-soft);
}

.bar-label {
  width: 78rpx;
  font-size: 24rpx;
  color: var(--c-ink-2);
  letter-spacing: 0.08em;
  flex-shrink: 0;
}

.bar-track {
  flex: 1;
  height: 2rpx;
  background: var(--c-rule-strong);
  margin: 0 24rpx;
  position: relative;
}

.bar-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 2rpx;
  background: var(--c-ink);
}

/* 饮水用次级墨色：不是每一条都同等重要 */
.bar-fill.soft {
  background: var(--c-ink-3);
}

.bar-val {
  width: 170rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--c-ink-3);
  letter-spacing: 0.02em;
  flex-shrink: 0;
}

/* ---- 心情自评 ----
 * 与上面三条刻度刻意不同构：刻度是读出来的，这一行是写进去的。
 * 没有进度条、没有百分比，五个方格填墨即止，右侧只给一句主观词。
 * 格子视觉 18rpx，热区 44rpx——18rpx 在真机上点不中。 */
.mood {
  display: flex;
  align-items: center;
  height: 44rpx;
  margin-top: 12rpx;
}

/* 与 .bar-label 同宽同色，左边缘与上面三条对齐 */
.mood-label {
  width: 78rpx;
  font-size: 24rpx;
  color: var(--c-ink-2);
  letter-spacing: 0.08em;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 与 .bar-track 同缩进（左右各 24rpx），方格起点落在刻度线起点上。
   五格沿整条刻度线均分，第 5 格右边缘正好压在线的终点：
   位置本身就编码了分值，也和上面三条等宽，不会显出一截短。 */
.mood-cells {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx;
}

.mood-cell {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mood-cell::before {
  content: "";
  width: 18rpx;
  height: 18rpx;
  border: 1rpx solid var(--c-ink-4);
}

.mood-cell.on::before {
  background: var(--c-ink);
  border-color: var(--c-ink);
}

/* 按下未选中的格子时先给一点回声，否则点空的没反应会以为坏了 */
.mood-cell-hover::before {
  background: var(--c-rule-strong);
}

/* 与 .bar-val 同宽同为右对齐 */
.mood-word {
  width: 170rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--c-ink-3);
  flex-shrink: 0;
}

/* ---- 五个动作 ----
 * 原先这里只有图标和字，形态与底部 tabBar 完全一致（图标在上、字在下、五等分、无容器），
 * 用户会把「导航的位置形态」认成「导航」，可它是操作。补上纸格：
 * 上下各一条发丝线围成一条带，格与格之间一条竖线。
 * 表格线是纸本来就有的东西，不引入色块、不新增第二个朱色焦点。 */
.acts {
  display: flex;
  margin-top: 14rpx;
  border-top: 1rpx solid var(--c-rule);
  border-bottom: 1rpx solid var(--c-rule);
  /* 铺一层比纸深半度的底：直角浅色带与 tabBar 的纯纸底区分开，
     眼睛先认出「这一条是另一种东西」，再读上面的五个字。 */
  background: var(--c-rule-soft);
}

.act {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 14rpx;
  position: relative;
}

/* 分格竖线画在格子左缘，第一格留空 */
.act + .act::before {
  content: "";
  position: absolute;
  left: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 1rpx;
  background: var(--c-rule-soft);
}

.act-ico {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 12rpx;
}

/* 字提到主墨色：格子里写的东西是正文，不是注脚 */
.act-txt {
  font-size: 24rpx;
  color: var(--c-ink);
  letter-spacing: 0.12em;
}

/* ---- 底部 ----
 * 上横线由 .acts 的 border-bottom 承担，这里不再画第二条，
 * 否则动作带底下会出现两条 26rpx 间距的平行线。 */
.foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 0;
  padding-top: 24rpx;
  font-size: 24rpx;
  color: var(--c-ink-3);
  letter-spacing: 0.04em;
  /* 热区扩展：整行加高到 88rpx，但用伪元素，不改变现有排布与一屏高度 */
  position: relative;
}

.foot::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 88rpx;
  transform: translateY(-50%);
}

.foot .n {
  color: var(--c-ink);
}

.foot .ar {
  color: var(--c-ink-5);
}

/* ---- 空状态 ---- */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 40rpx 0;
}

.empty-title {
  font-size: 44rpx;
  letter-spacing: 0.12em;
  color: var(--c-ink);
}

.empty-sub {
  font-size: 24rpx;
  color: var(--c-ink-3);
  margin-top: 18rpx;
  text-align: center;
  letter-spacing: 0.04em;
}

.empty-btn {
  margin-top: 56rpx;
  padding: 25rpx 52rpx;
  border: 1rpx solid var(--c-ink);
  font-size: 24rpx;
  color: var(--c-ink);
  letter-spacing: 0.14em;
  border-radius: 4rpx;
}
