<view class="page">

  <!-- 顶栏：日期 + 多猫切换。次要功能退到工具层，不参与视线。 -->
  <view class="topline">
    <text class="date">{{today}}</text>
    <view class="switcher">
      <!-- 热区放在 view 上：伪元素画在 <text> 上微信渲染层不生效（已实测），
           所以 88rpx 的点击区不能靠 <text>::after 撑。 -->
      <view
        class="sw-hit {{item.id === cat.id ? 'on' : ''}}"
        wx:for="{{cats}}"
        wx:key="id"
        data-id="{{item.id}}"
        hover-class="sw-hit-hover"
        bindtap="onSwitch"
      ><text class="sw">{{item.name}}</text></view>
      <view class="sw-hit" hover-class="sw-hit-hover" bindtap="goAdd"><text class="sw-add">＋</text></view>
    </view>
  </view>
  <view class="hairline"></view>

  <block wx:if="{{cat.id}}">

    <view class="name">{{cat.name}}</view>
    <view class="sub">{{cat.ageText}} · {{cat.breed}}</view>

    <!-- 照片与几何形象二选一，由档案页的「显示方式」决定。
         照片用 aspectFit 而不是 aspectFill：档案页允许自己换图，比例不可控，
         按宽度裁满会把猫的头或尾巴切掉——宁可留边，也要让整只猫在画面里。
         这里原本还挂了 bindtap（点一下缩一下，无任何功能），已移除：
         看不出能点、点了又什么都没发生，是可点击区域里最差的一种。 -->
    <view class="photo-slot">
      <cat-figure
        wx:if="{{cat.avatarType === 'figure'}}"
        color="{{cat.figure ? cat.figure.color : 'ink'}}"
        accessory="{{cat.figure ? cat.figure.accessory : 'none'}}"
        size="320rpx"
      />
      <image wx:else class="photo" src="{{cat.avatar}}" mode="aspectFit" />
    </view>

    <view class="weigh">
      <view class="weigh-main">
        <text class="num">{{cat.weight}}</text>
        <text class="unit">KG</text>
        <text class="delta {{trend.delta >= 0 ? '' : 'down'}}">{{trend.delta >= 0 ? '↑' : '↓'}} {{trend.text}}</text>
      </view>

      <!-- 首页唯一的彩色焦点：今日照顾分。弧色随分值从红走到绿，
           低分是警示、高分是「做到了」，不再是固定的品牌朱。 -->
      <view class="ring-wrap">
        <view class="ring" style="background: {{careRing}};">
          <view class="ring-hole"><text class="ring-num">{{care}}</text></view>
        </view>
        <text class="ring-cap">今日照顾</text>
      </view>
    </view>

    <!-- 三条刻度：线长即完成度，右侧写绝对值，同一件事只说一遍。
         三项全部来自今天的记录，没有一项是档案里的固定值。 -->
    <view class="bars">
      <view class="bar">
        <text class="bar-label">进食</text>
        <view class="bar-track"><view class="bar-fill" style="width: {{pct.food}}%;"></view></view>
        <text class="bar-val">{{pct.foodAbs}} / {{pct.foodTarget}} g</text>
      </view>
      <view class="bar">
        <text class="bar-label">饮水</text>
        <view class="bar-track"><view class="bar-fill soft" style="width: {{pct.water}}%;"></view></view>
        <text class="bar-val">{{pct.waterAbs}} / {{pct.waterTarget}} ml</text>
      </view>
      <view class="bar">
        <text class="bar-label">逗猫</text>
        <view class="bar-track"><view class="bar-fill" style="width: {{pct.play}}%;"></view></view>
        <text class="bar-val">{{pct.playAbs}} / {{pct.playTarget}} min</text>
      </view>
    </view>

    <!-- 心情自评：与上面三条刻意不同构。
         刻度是「从记录算出来的」，这一行是「你看到的」——所以它没有进度条、
         没有百分比，只有五个格子。它也不进照顾分。 -->
    <view class="mood">
      <text class="mood-label">心情</text>
      <view class="mood-cells">
        <view
          class="mood-cell {{mood === item ? 'on' : ''}}"
          wx:for="{{moodScale}}"
          wx:key="*this"
          data-v="{{item}}"
          hover-class="mood-cell-hover"
          bindtap="onMood"
        ></view>
      </view>
      <text class="mood-word">{{moodText}}</text>
    </view>

    <!-- 五个动作：只有线条图标与字，没有色块。
         「症状」排在最后：前四个是记一笔就完的日常操作，它是唯一会跳页的，
         但同处一行、同样尺寸，不做视觉区分，免得首页出现第二个焦点。 -->
    <view class="acts">
      <view class="act" hover-class="tap-active" bindtap="onFeed">
        <image class="act-ico" src="/images/icons/feed.png" mode="aspectFit" />
        <text class="act-txt">投食</text>
      </view>
      <view class="act" hover-class="tap-active" bindtap="onWater">
        <image class="act-ico" src="/images/icons/water.png" mode="aspectFit" />
        <text class="act-txt">喂水</text>
      </view>
      <view class="act" hover-class="tap-active" bindtap="onPlay">
        <image class="act-ico" src="/images/icons/play.png" mode="aspectFit" />
        <text class="act-txt">逗猫</text>
      </view>
      <view class="act" hover-class="tap-active" bindtap="onWeigh">
        <image class="act-ico" src="/images/icons/weight.png" mode="aspectFit" />
        <text class="act-txt">称重</text>
      </view>
      <view class="act" hover-class="tap-active" bindtap="onSymptom">
        <image class="act-ico" src="/images/icons/doc.png" mode="aspectFit" />
        <text class="act-txt">症状</text>
      </view>
    </view>

    <view class="foot" hover-class="tap-active" bindtap="goRecords">
      <text>今天 · <text class="n">{{todayCount}}</text> 条记录</text>
      <text class="ar">›</text>
    </view>

  </block>

  <!-- 空状态 -->
  <view class="empty" wx:else>
    <text class="empty-title">还没有猫咪档案</text>
    <text class="empty-sub">先建一只，喵管家才知道该照顾谁</text>
    <view class="empty-btn" hover-class="tap-active" bindtap="goAdd">添加第一只猫</view>
  </view>

  <!-- 用量面板。投食 / 喂水 / 逗猫共用一套壳，只是档位与单位不同。
       为什么不是「点一下直接 +40g」：40 g 是别人家的数，用户要知道的是
       「这一顿给了多少」。档位只负责省打字，最终以输入框里的数为准。 -->
  <view
    class="sheet-mask {{sheet.open ? 'on' : ''}}"
    bindtap="onSheetClose"
    catchtouchmove="noop"
  ></view>

  <view class="sheet {{sheet.open ? 'on' : ''}}">
    <view class="sheet-head">
      <text class="sheet-title">{{sheet.title}}</text>
      <text class="sheet-sub">今天已 {{sheet.before}} / {{sheet.target}} {{sheet.unit}}</text>
    </view>

    <view class="sheet-opts">
      <view
        class="opt {{sheet.value === item ? 'on' : ''}}"
        wx:for="{{sheet.presets}}"
        wx:key="*this"
        data-v="{{item}}"
        hover-class="opt-hover"
        bindtap="onPreset"
      ><text class="opt-n">{{item}}</text></view>
    </view>

    <view class="sheet-row">
      <input
        class="sheet-input"
        type="number"
        value="{{sheet.value}}"
        placeholder="或直接填"
        placeholder-class="sheet-ph"
        bindinput="onAmountInput"
        adjust-position="{{true}}"
      />
      <text class="sheet-unit">{{sheet.unit}}</text>
    </view>

    <text class="sheet-tip {{sheet.tip.cls}}">{{sheet.tip.text}}</text>

    <view class="sheet-btn" hover-class="sheet-btn-hover" bindtap="onSheetConfirm">
      <text class="sheet-btn-txt">记录</text>
    </view>
  </view>

</view>
